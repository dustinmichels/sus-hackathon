---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PixelArt from '../components/PixelArt.astro';
import greenFundLogo from '../assets/green-fund-logo.png';
import { ring, sparkle, vine } from '../data/pixels';
import { event, perks, prizes, schedule } from '../data/event';

const title = `${event.name} at Tufts, ${event.dates}, ${event.year}`;
const description =
  'Grow sustainable solutions for Tufts campus and implement them through the Green Fund. Beginner friendly, all majors welcome, $1000+ in cash prizes.';
---

<Base title={title} description={description}>
  <header class="flyer">
    <PixelArt art={vine} class="vine vine-left" />
    <PixelArt art={vine} class="vine vine-right" />
    <PixelArt art={ring} px={5} class="spark s1" />
    <PixelArt art={sparkle} px={4} class="spark s2" />
    <PixelArt art={ring} px={4} class="spark s3" />

    <div class="body">
      <p class="ask">Looking to create sustainable solutions at Tufts?</p>
      <div class="diamonds" aria-hidden="true"></div>
      <h1>
        <span>Sustainable</span>
        <span>Project</span>
        <span>Hackathon</span>
      </h1>
      <p class="pill when">
        <time datetime={`${event.year}-11-14`}>Nov 14</time>–
        <time datetime={`${event.year}-11-15`}>
          15<sup>th</sup>
        </time>{' '}
        @ {event.room}
      </p>
      <p class="pitch">
        Grow sustainable solutions for Tufts campus and implement them through the Green Fund!
      </p>
      <ul class="perks" aria-label="Highlights">
        {perks.map((perk) => (
          <li class="pill">{perk}</li>
        ))}
      </ul>
      <span class="cta">
        <a class="btn" href={event.registerUrl} target="_blank" rel="noopener">
          Register here!
        </a>
      </span>
    </div>
  </header>

  <main class="info">
    <div class="block">
      <h2>About</h2>
      <p>
        Teams of 3 to 5 students from every field take on real Tufts challenges and turn ideas into
        working solutions over 24 hours. No team? You’ll form one on the day.
      </p>
    </div>

    <div class="block">
      <h2>Schedule</h2>
      <div class="days">
        {schedule.map((day) => (
          <div>
            <h3>{day.day}</h3>
            <ol>
              {day.events.map((item) => (
                <li>
                  <span class="time">{item.time}</span>
                  <span>{item.title}</span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </div>

    <div class="block">
      <h2>Prizes</h2>
      <ul class="prizes">
        {prizes.map((prize) => (
          <li>
            <span class="amount">{prize.amount}</span>
            <span class="place">{prize.place}</span>
          </li>
        ))}
      </ul>
      <p>Winners can turn their idea into a Green Fund project, with help on the application.</p>
    </div>
  </main>

  <footer>
    <div class="sponsors">
      <p class="visually-hidden">Sponsored by</p>
      <Image src={greenFundLogo} alt="Tufts University Green Fund" width={285} />
      <p class="tcu">
        <span>TCU Sustainability Sub-Committee</span>
        <span class="tcu-sub">Tufts Community Union Senate</span>
      </p>
    </div>
    <p class="contact">
      Questions? Email <a href={`mailto:${event.email}`}>{event.email}</a>
    </p>
  </footer>
</Base>

<style>
  .flyer {
    --vpx: 6px;
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 4vh, 4rem) calc(18 * var(--vpx) + var(--gutter));
  }

  .vine {
    position: absolute;
    bottom: 0;
    width: calc(18 * var(--vpx));
    height: calc(180 * var(--vpx));
  }

  .vine-left {
    left: 0;
  }

  .vine-right {
    right: 0;
    bottom: calc(-18 * var(--vpx));
    transform: scaleX(-1);
  }

  .spark {
    position: absolute;
  }
  .s1 {
    top: 9rem;
    left: calc(18 * var(--vpx) + 2%);
  }
  .s2 {
    top: 2.5rem;
    left: 82%;
  }
  .s3 {
    top: 6rem;
    right: calc(18 * var(--vpx) + 1%);
  }

  .body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 2.2vh, 1.5rem);
    max-width: 56rem;
    text-align: center;
  }

  .ask {
    font-family: var(--font-pixel);
    font-size: var(--pixel-l);
    line-height: 1.5;
    color: var(--signal);
    max-width: 30ch;
  }

  .body .diamonds {
    width: min(100%, 26rem);
  }

  h1 {
    display: flex;
    flex-direction: column;
    font-size: clamp(1.5rem, min(6.4vw, 8.5vh), 4.5rem);
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--signal);
  }

  .when {
    font-size: var(--pixel-m);
  }

  .when sup {
    font-size: 0.55em;
  }

  .pitch {
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .perks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cta {
    margin-top: 0.5rem;
  }

  .info {
    display: grid;
    gap: 3.5rem;
    width: 100%;
    max-width: 48rem;
    margin-inline: auto;
    padding: 2rem var(--gutter) 4.5rem;
  }

  .block {
    display: grid;
    gap: 1rem;
  }

  h2 {
    font-size: var(--pixel-l);
    color: var(--signal);
  }

  .days {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 3rem;
  }

  h3 {
    margin: 0 0 0.5rem;
    font-size: var(--step-0);
  }

  .days ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .days li {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    padding-block: 0.35rem;
  }

  .time {
    color: var(--signal);
  }

  .prizes {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prizes li {
    display: grid;
  }

  .amount {
    font-family: var(--font-pixel);
    font-size: var(--pixel-l);
    line-height: 1.4;
  }

  .place {
    color: var(--muted);
  }

  footer {
    padding-bottom: 2rem;
  }

  .sponsors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem 4rem;
    padding: 1.75rem var(--gutter);
    background: #fff;
    color: var(--ink);
  }

  .sponsors img {
    width: 285px;
    height: auto;
  }

  .tcu {
    display: grid;
    font-size: var(--step-1);
    line-height: 1.2;
    text-align: center;
  }

  .tcu-sub {
    font-size: 1rem;
    color: #3d3d3d;
  }

  .contact {
    margin-top: 2rem;
    padding-inline: var(--gutter);
    text-align: center;
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .flyer {
      --vpx: 4px;
    }
  }

  /* Short laptop screens: keep the perks to two rows so the hero fits without scrolling. */
  @media (max-height: 820px) {
    .perks .pill {
      font-size: var(--pixel-s);
    }
  }

  @media (max-width: 760px) {
    .flyer {
      --vpx: 2.5px;
      padding-inline: calc(18 * var(--vpx) + 0.75rem);
    }
    .ask {
      font-size: var(--pixel-m);
    }
    .s1,
    .s2 {
      display: none;
    }
    .perks .pill {
      font-size: var(--pixel-s);
    }
    .days {
      grid-template-columns: 1fr;
    }
  }
</style>
