---
// Renders an ASCII sprite from src/data/pixels.ts as a crisp SVG.
import type { HTMLAttributes } from 'astro/types';
import { parseSprite } from '../data/pixels';

interface Props extends HTMLAttributes<'svg'> {
  art: string;
  /** Rendered size of one sprite pixel, in CSS px. */
  px?: number;
}

const { art, px = 4, ...attrs } = Astro.props;
const { width, height, rects } = parseSprite(art);
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  width={width * px}
  height={height * px}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
  {...attrs}
>
  {rects.map((r) => (
    <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />
  ))}
</svg>
